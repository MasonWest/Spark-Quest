  "title": "写一份字段清楚的订单投影",
  "mission": "从列名、常量与单位出发，产出能被下游理解的结果。",
  "correction": "单引号表示字符串，反引号引用标识符。SELECT 输出的别名决定结果字段；DISTINCT 按完整输出列组合去重。",
  "source": "https://spark.apache.org/docs/3.5.7/sql-ref-syntax-qry-select.html",
  "next": "先用自己的话解释本课的判断，再进入下一课。正式测验沿用原有规则。",
  "tasks": [
    {
      "id": "l3-select-basics/literal",
      "knowledgeIds": [
        "select.literal"
      ],
      "title": "同样写 amount，意思不同",
      "intro": "orders 中 amount=120。",
      "code": "SELECT amount, 'amount' AS label FROM orders",
      "prompt": "这一行两列分别是什么？",
      "fields": [
        {
          "id": "answer",
          "label": "你的判断",
          "correctOptionId": "o0",
          "options": [
            {
              "id": "o1",
              "text": "120 和 120",
              "feedback": "第二个表达式不是列引用。"
            },
            {
              "id": "o2",
              "text": "amount 和 amount 两个字段名",
              "feedback": "查询结果包含值，不只是名称。"
            },
            {
              "id": "o0",
              "text": "120 和字符串 amount",
              "feedback": "对，单引号内是固定文本。"
            }
          ]
        }
      ],
      "insight": "读取列值与给所有行放一个标签，是不同的投影表达式。",
      "ability": "同样写 amount，意思不同",
      "reading": {
        "id": "l3-select-basics/literal/reading",
        "title": "同样写 amount，意思不同",
        "sectionTitle": "先用人话理解",
        "startMarker": "【先用人话理解】",
        "endMarker": "【一个直观的心智模型】",
        "connection": "读取列值与给所有行放一个标签，是不同的投影表达式。",
        "boundary": "不要把 Python 字符串的外层引号与 SQL 文本内部的引号混淆。",
        "caution": "这是保留的旧讲义，部分简化口径已经修订。请以当前标准讲解为准；旧示例的输入与本题不一定相同。"
      },
      "remediation": {
        "id": "l3-select-basics/literal-transfer",
        "knowledgeId": "select.literal",
        "title": "标签也叫 city",
        "intro": "换一份材料，只验证刚才这个判断。",
        "code": "-- city 的值是 north\nSELECT city, 'city' AS tag FROM stores",
        "prompt": "输出的 tag 是什么？",
        "field": {
          "id": "answer",
          "label": "变式判断",
          "correctOptionId": "r1",
          "options": [
            {
              "id": "r1",
              "text": "字符串 city",
              "feedback": "对，单引号指定常量。"
            },
            {
              "id": "r0",
              "text": "north",
              "feedback": "north 是第一列的值。"
            },
            {
              "id": "r2",
              "text": "NULL",
              "feedback": "常量字符串不因字段内容而变成 NULL。"
            }
          ]
        },
        "insight": "常量的文本可以恰好与列名相同，含义仍不同。"
      }
    },
    {
      "id": "l3-select-basics/units",
