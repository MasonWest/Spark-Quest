    {
      "id": "l3-select-basics/identifier",
      "knowledgeIds": [
        "select.identifier"
      ],
      "title": "含空格的列如何引用",
      "intro": "表里有一个真实字段叫 order amount。",
      "code": "SELECT __A__ AS amount FROM orders",
      "prompt": "哪个写法引用这个字段？",
      "fields": [
        {
          "id": "answer",
          "label": "你的判断",
          "correctOptionId": "o1",
          "options": [
            {
              "id": "o0",
              "text": "'order amount'",
              "feedback": "这是固定字符串。"
            },
            {
              "id": "o1",
              "text": "`order amount`",
              "feedback": "对，反引号包住完整标识符。"
            },
            {
              "id": "o2",
              "text": "order amount",
              "feedback": "空格会参与 SQL 语法解析，不是完整列名引用。"
            }
          ]
        }
      ],
      "insight": "标识符与字符串常量的引号不能互换。",
      "ability": "含空格的列如何引用",
      "reading": {
        "id": "l3-select-basics/identifier/reading",
        "title": "含空格的列如何引用",
        "sectionTitle": "先用人话理解",
        "startMarker": "【先用人话理解】",
        "endMarker": "【一个直观的心智模型】",
        "connection": "标识符与字符串常量的引号不能互换。",
        "boundary": "名称本身包含反引号时还需要转义；本题只处理空格。",
        "caution": "这是保留的旧讲义，部分简化口径已经修订。请以当前标准讲解为准；旧示例的输入与本题不一定相同。"
