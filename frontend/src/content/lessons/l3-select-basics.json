    },
    {
      "id": "l3-select-basics/distinct",
      "knowledgeIds": [
        "select.distinct"
      ],
      "title": "只选城市后再去重",
      "intro": "明细有 (north,10)、(north,20)、(south,10)。",
      "code": "SELECT DISTINCT city FROM orders",
      "prompt": "结果包含几行？",
      "fields": [
        {
          "id": "answer",
          "label": "你的判断",
          "correctOptionId": "o1",
          "options": [
            {
              "id": "o0",
              "text": "3 行，因为原明细不同",
              "feedback": "去重依据已经是输出的 city，不是全部原始明细。"
            },
            {
              "id": "o2",
              "text": "1 行，因为金额 10 重复",
              "feedback": "本查询没有输出金额。"
            },
            {
              "id": "o1",
              "text": "2 行，因为输出城市只有两个",
              "feedback": "对，north 和 south 各一行。"
            }
          ]
        }
      ],
      "insight": "DISTINCT 对 SELECT 的整组输出列去重；增加输出列会改变重复定义。",
      "ability": "只选城市后再去重",
      "reading": {
        "id": "l3-select-basics/distinct/reading",
        "title": "只选城市后再去重",
