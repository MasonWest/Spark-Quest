            {
              "id": "o1",
              "text": "amount / 1000.0",
              "feedback": "对，除以 1000.0。"
            },
            {
              "id": "o0",
              "text": "amount * 1000.0",
              "feedback": "从元到千元应缩小一千倍。"
            },
            {
              "id": "o2",
              "text": "'amount'",
              "feedback": "这是字符串，不是金额表达式。"
            }
          ]
