{
  "name": "spark-quest-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:css": "node scripts/check-css-namespace.mjs",
    "check:css:all": "node scripts/check-css-namespace.mjs --all",
    "test:weak-grouping": "node --test scripts/weak-grouping.test.ts",
    "check:content": "node scripts/check-journey-content.mjs",
    "test:journey": "node --test scripts/journey-progress.test.mjs scripts/journey-answer.test.mjs",
    "prebuild": "npm run check:content"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
